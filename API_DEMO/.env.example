# API_DEMO — Netlify / local Vite env (do NOT commit real values)
# Local: leave empty to use Vite proxy → http://localhost:8787
# Netlify: must be the public Render API origin (no trailing slash)

VITE_API_BASE=

# Google Maps JavaScript API key (enable Maps JavaScript API + Directions API)
# Restrict by HTTP referrer to your Netlify domain + localhost
VITE_GOOGLE_MAPS_API_KEY=
