# Copy values from DeployCDCI/.env (or set path to service account JSON)
PORT=8787
FIREBASE_PROJECT_ID=keiros-erp
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\keiros-erp-firebase-adminsdk.json
FIRESTORE_PREFER_REST=true
# Demo key accepted when it starts with an Active api_keys.prefix
# Example: keiros_live_ot_demo_map_nav_2026
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
