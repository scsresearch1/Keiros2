# Copy values from DeployCDCI/.env (or set path / inline JSON)
PORT=8787
FIREBASE_PROJECT_ID=keiros-erp

# Option A — local file path to service-account JSON
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\keiros-erp-firebase-adminsdk.json

# Option B — Render / cloud: paste the FULL service-account JSON as one line
# (or base64-encode the JSON). Do not commit real credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

FIRESTORE_PREFER_REST=true
# Demo key accepted when it starts with an Active api_keys.prefix
# Example: keiros_live_ot_demo_map_nav_2026

# Comma-separated browser origins allowed to call the API
# Include localhost for local demos + your Netlify URLs for production
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173

# Set true only to force in-memory seed data (bypass Firestore)
FIRESTORE_LOCAL_FALLBACK=false
