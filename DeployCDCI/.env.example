# DeployCDCI — fill from Firebase Console, then: npm run setup
# NEVER commit this file or service-account JSON.

# --- Project ---
FIREBASE_PROJECT_ID=your-project-id

# --- Web app config (Project settings → Your apps → SDK setup) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Admin SDK (Project settings → Service accounts → Generate new private key) ---
# Absolute path to the downloaded JSON, e.g. F:\secrets\keiros-firebase-adminsdk.json
GOOGLE_APPLICATION_CREDENTIALS=

# --- Auth seed ---
SEED_ADMIN_EMAIL=admin@keiros.ai
SEED_ADMIN_PASSWORD=Keiros@1234
SEED_DEFAULT_USER_PASSWORD=Keiros@1234

# --- Optional ---
FIRESTORE_LOCATION=asia-south1
VITE_USE_FIREBASE=true

# Keriosa live/locked field data (separate Firebase project; RTDB REST from browser)
VITE_KERIOSA_RTDB_URL=https://keriosa-default-rtdb.firebaseio.com
CLEAR_COLLECTIONS_BEFORE_SEED=false
