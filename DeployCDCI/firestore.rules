rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Bootstrap: authenticated users can read/write.
    // Tighten with role claims before production.
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}
