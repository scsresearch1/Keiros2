# API_DEMO — Netlify / local Vite env (do NOT commit real values)
# Local: leave empty to use Vite proxy → http://localhost:8787
# Netlify: must be the public Render API origin (no trailing slash)

VITE_API_BASE=

# Google Maps JavaScript API key
# Enable: Maps JavaScript API + Routes API (legacy Directions is often blocked)
# Restrict by HTTP referrer to your Netlify domain + localhost
VITE_GOOGLE_MAPS_API_KEY=

# Map ID for vector map + Advanced Markers (current Google rendering)
# Cloud Console → Google Maps Platform → Map Management → Create Map ID (JavaScript)
# Leave empty / omit to use DEMO_MAP_ID (fine for testing; create your own for production)
VITE_GOOGLE_MAPS_MAP_ID=
